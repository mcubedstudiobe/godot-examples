config_version=5

[application]
config/name="Punchy Shot Feedback"
run/main_scene="res://range.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1120
window/size/window_height_override=630
window/stretch/mode="canvas_items"

[input]
fire={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
wall_shot={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]
renderer/rendering_method="forward_plus"

[editor]

movie_writer/mjpeg_quality=0.95
